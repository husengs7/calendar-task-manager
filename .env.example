# Google Calendar URLs (Secret iCal URLs)
WORK_CALENDAR_URL="https://calendar.google.com/calendar/ical/your_work_email%40example.com/private-xxxxxx/basic.ics"
PRIVATE_CALENDAR_URL="https://calendar.google.com/calendar/ical/your_private_email%40gmail.com/private-xxxxxx/basic.ics"

# Google Apps Script Webhook URL for sync
GAS_SYNC_URL="https://script.google.com/macros/s/xxxxxx/exec"

# Options
MASK_TITLE="false" # Set "true" to mask event titles with "[Work] Busy"
SYNC_DAYS="30"     # Number of days to sync forward
